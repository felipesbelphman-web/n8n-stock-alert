      "id": "1f41a23c-abb4-4596-9081-aaaef1e611c0",
      "name": "Stock Available"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(item => item.json);\n\nconst totalUnits = products.reduce(\n  (total, product) => total + product.restock_quantity,\n  0\n);\n\nconst lines = products.map(product =>\n  `- ${product.product}: ${product.quantity} available, ` +\n  `minimum ${product.minimum}, ` +\n  `restock ${product.restock_quantity} units`\n);\n\nreturn [{\n  json: {\n    subject: \"Low Stock Alert\",\n    products_count: products.length,\n    total_restock_units: totalUnits,\n    message: [\n      \"The following products need restocking:\",\n      \"\",\n      ...lines,\n      \"\",\n      `Total units needed to reach minimum stock: ${totalUnits}`\n    ].join(\"\\n\")\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        -64
      ],
      "id": "5bcf984f-c4ce-4153-8794-3498e6b854fc",
      "name": "Build Stock Summary"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "75a786a8-ad0c-4feb-ac5f-c4b6e940f2f5",
              "leftValue": "={{ $json.quantity }}",
              "rightValue": "={{ $json.minimum }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
